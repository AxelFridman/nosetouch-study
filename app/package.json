{
  "name": "nose-touch-collector",
  "private": true,
  "version": "0.1.0",
  "description": "Progressive Web App that records phone motion sensors while participants bring the phone to their nose with the left or right hand.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "synth": "tsx scripts/synth.ts",
    "eval:seg": "tsx scripts/evalSegmentation.ts",
    "icons": "py -3 scripts/make_icons.py"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
